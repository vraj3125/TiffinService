# Copy this file to .env.local and paste your own values.
# Firebase web config -> Console > Project settings > General > Your apps > SDK setup.
# These are public client identifiers, not secrets, but keep .env.local out of git.
# Restart `npm run dev` after editing -- Vite only reads env vars at startup.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Secret used to obfuscate query params in links (see src/lib/secureParams.js).
# Any random string. Changing it invalidates already-shared links.
VITE_URL_PARAM_SECRET=

# Location suggestions. Options:
#   photon (default) - komoot's public Photon API over OpenStreetMap.
#                      No key, no signup, no billing. Leave everything below blank.
#   google           - Google Places. Needs the key below and an active billing account.
#   local            - the built-in Vadodara locality list only, no network calls.
VITE_PLACES_PROVIDER=photon

# Only needed when VITE_PLACES_PROVIDER=google.
VITE_GOOGLE_MAPS_API_KEY=
